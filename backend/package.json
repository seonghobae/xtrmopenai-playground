{
  "name": "openai-playground-backend",
  "version": "1.0.0",
  "description": "OpenAI Playground Backend - MCP Test Harness & Responses API Testing Platform",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "openai",
    "mcp",
    "responses-api",
    "playground",
    "casdoor",
    "oidc"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/session": "^11.0.1",
    "@fastify/cookie": "^10.0.1",
    "fastify": "^5.1.0",
    "zod": "^3.23.8",
    "pg": "^8.13.1",
    "undici": "^7.2.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "jose": "^5.9.6",
    "dotenv": "^16.4.7",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
