# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=openai_playground
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here
DATABASE_MAX_CONNECTIONS=10
DATABASE_SSL_CA=
DATABASE_SSL_CERT=
DATABASE_SSL_KEY=

# Casdoor OIDC Configuration
OIDC_ISSUER=https://your-casdoor-instance.com
OIDC_CLIENT_ID=your_client_id
OIDC_CLIENT_SECRET=your_client_secret
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_SCOPE="openid profile email"

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Security Configuration
SESSION_SECRET=generate_a_secure_random_string_at_least_32_characters_long
SESSION_TTL_SECONDS=86400
SESSION_INACTIVITY_SECONDS=3600
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Environment
NODE_ENV=development
LOG_LEVEL=info
